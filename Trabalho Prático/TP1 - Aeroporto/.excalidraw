      "seed": 307107640,
      "version": 533,
      "versionNonce": 90034600,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779396812551,
      "link": null,
      "locked": false,
      "text": "Implementação própria de uma Lista Duplamente Encadeada\nutilizando nós com ponteiros de Cabeça e Cauda, garantindo\noperações de inserção e remoção nas extremidades em tempo\nO(1), que para filas, é excelente.",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Implementação própria de uma Lista Duplamente Encadeada utilizando nós com ponteiros de Cabeça e Cauda, garantindo operações de inserção e remoção nas extremidades em tempo O(1), que para filas, é excelente.",
      "autoResize": false,
      "lineHeight": 1.35
    },
