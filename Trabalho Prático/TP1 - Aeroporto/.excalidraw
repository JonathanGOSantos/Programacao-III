    {
      "id": "Q8STR_k2NxKOkTf3ECAWq",
      "type": "text",
      "x": -413.42714036940424,
      "y": -1480.9627056751274,
      "width": 1260.61083984375,
      "height": 226.8,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2u",
      "roundness": null,
      "seed": 2040985144,
      "version": 844,
      "versionNonce": 2142432424,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779396972152,
      "link": null,
      "locked": false,
      "text": "O balanceamento das prateleiras é responsabilidade da TorreDeControle.\nAo chegar um avião, ele busca a pista com menos aviões. \nApós buscar a menor pista, busca a menor prateleira para a operação e lá adiciona o avião.\n\nApós checar as emergências, o acesso à pista é concedido comparando diretamente o menor ID\nentre o primeiro da fila de decolagem e o primeiro da fila de pouso selecionada.",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O balanceamento das prateleiras é responsabilidade da TorreDeControle.\nAo chegar um avião, ele busca a pista com menos aviões. \nApós buscar a menor pista, busca a menor prateleira para a operação e lá adiciona o avião.\n\nApós checar as emergências, o acesso à pista é concedido comparando diretamente o menor ID entre o primeiro da fila de decolagem e o primeiro da fila de pouso selecionada.",
      "autoResize": false,
      "lineHeight": 1.35
    },
