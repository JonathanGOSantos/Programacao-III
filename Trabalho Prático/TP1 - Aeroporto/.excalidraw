    {
      "id": "QaV0kfilHr2hlhV3dVHTj",
      "type": "text",
      "x": -1188.3905364194698,
      "y": -1035.5312978907707,
      "width": 689.3035888671875,
      "height": 378.00000000000006,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b37",
      "roundness": null,
      "seed": 1771995960,
      "version": 776,
      "versionNonce": 2074929736,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "HzrRf85Y42gw3at9mOvmC",
          "type": "arrow"
        }
      ],
      "updated": 1779368969411,
      "link": null,
      "locked": false,
      "text": "Optamos por utilizar ids sequênciais e sem distinção \nentre aterrissagem e decolagem. O que utilizamos no \ncódigo para sua representação é o enum Operação, \nque permite POUSO ou DECOLAGEM.  Chegamos a \nessa solução por achar melhor para o balanceamento, \no avião mais antigo pousar primeiro. Com os ids \ndistintos, poderiam vir 3 aviões para decolar e 1 para \naterrisar, e a prioridade ser o de aterrissar pelo id ser\nmenor, o que não queriamos. Para nós, o ID representa\na ordem de chegada dos aviões.",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Optamos por utilizar ids sequênciais e sem distinção \nentre aterrissagem e decolagem. O que utilizamos no \ncódigo para sua representação é o enum Operação, \nque permite POUSO ou DECOLAGEM.  Chegamos a \nessa solução por achar melhor para o balanceamento, \no avião mais antigo pousar primeiro. Com os ids \ndistintos, poderiam vir 3 aviões para decolar e 1 para \naterrisar, e a prioridade ser o de aterrissar pelo id ser\nmenor, o que não queriamos. Para nós, o ID representa\na ordem de chegada dos aviões.",
      "autoResize": true,
      "lineHeight": 1.35
    },
