    {
      "id": "FEjvBEpnsgoikSXKFiGWK",
      "type": "text",
      "x": 623.8594635805302,
      "y": -782.5312978907707,
      "width": 824.7614746093751,
      "height": 151.20000000000002,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
